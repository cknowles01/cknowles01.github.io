---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projectsData from '../data/projects.json';

const featuredProjects = projectsData.filter(p => p.featured);
const otherProjects = projectsData.filter(p => !p.featured);
---

<Layout 
  title="Projects - Connor Knowles" 
  description="Explore my software engineering projects including mobile apps, security tools, and data visualization platforms."
>
  <section class="section-container">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">Projects</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
          A collection of my software engineering work, from data visualizations to video games
        </p>
      </div>

      {featuredProjects.length > 0 && (
        <div class="mb-16">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-2">
            <span>Featured Projects</span>
            <svg class="w-6 h-6 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
            </svg>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featuredProjects.map((project) => (
              <ProjectCard {...project} />
            ))}
          </div>
        </div>
      )}

      {otherProjects.length > 0 && (
        <div>
          <h2 class="text-2xl font-bold mb-8">Other Projects</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {otherProjects.map((project) => (
              <ProjectCard {...project} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
